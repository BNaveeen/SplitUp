    "cap:sync:ios": "npm run build:mobile && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
