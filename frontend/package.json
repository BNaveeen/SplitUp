  "version": "0.0.0",
  "type": "module",
  "homepage": "https://BNaveeen.github.io/SplitUp/",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite --host",
